cell_width = 20;  // mm

// Cell cavity depth. [PROVISIONAL]
//   TODO(verify): as cell_length. Must include the protection circuit, which
//   sits at one end of the pouch and is often thicker than the pouch itself.
cell_thickness = 6;  // mm

// Slack added around the cell on every face. [practice]
//   A pouch cell must not be a press fit. Cells swell slightly with age and
//   charge state, and a cavity that grips one is applying sustained pressure to
//   a lithium pouch. Retention is the strap's job, not the cavity's.
cell_squeeze = 0.6;  // mm

// --------------------------------------------------------------------------
// AIRFRAME
// The rocket the payload attaches to. These are the parameters a builder
// changes for their own vehicle, and the reason the source is published rather
// than only the STLs.

// Body tube outside diameter the pod saddle is cut for. [standard]
//   Estes BT-50, 0.976 in from the published catalogue dimension. This is the
//   one parameter most builders will change, which is the whole reason the
//   source is published. Measure your own tube: paper tube stock varies with
//   humidity and between production runs, and the saddle is the surface where
//   that variation shows up as a rock.
tube_od = 24.8;  // mm

// Body tube inside diameter the sled is sized for. [standard]
//   Estes BT-55, 1.283 in from the published catalogue dimension. Deliberately a
//   different airframe from tube_od above, because the two form factors suit
//   different rockets and pretending otherwise produced a part that did not
//   work. A BT-50 bore is 24.13 mm, and a 22 mm board inside it leaves 0.6 mm of
//   rail on each side: printable in the sense that a slicer will emit it, and
//   nothing in the sense of a part that survives a landing. The pod exists so a
//   small tube needs no payload bay at all; a sled needs a rocket that has one,
//   and a rocket with a payload section is a bigger rocket. BT-55 leaves 4.8 mm
//   a side. Measure your own tube and re-render either way.
tube_id = 32.59;  // mm

// --------------------------------------------------------------------------
// POD
// The external fairing, Form B.

// Fairing wall thickness. [derived]
//   Four perimeters at a 0.4 mm nozzle. Chosen as a multiple of the extrusion
//   width so the slicer produces solid wall rather than a thin gap it has to
//   fill badly.
pod_wall = 1.6;  // mm

// Length of the tapered leading fairing. [practice]
//   A taper long enough to keep the flow attached, kept short because every
//   millimetre is mass and drag on the outside of somebody's rocket. The
//   altitude penalty this trades against is unmeasured, and the Mounting page
//   says so.
pod_nose_len = 18;  // mm

// Length of the tapered trailing fairing. [practice]
//   Longer than the nose. A blunt tail separates the flow and separation costs
//   far more drag than a blunt leading edge does.
pod_tail_len = 26;  // mm

// Width of each strap slot. [standard]
//   Clears 1/2 in hook-and-loop strap, the common size, and comfortably clears a
//   3.6 mm cable tie. Two slots, so the pod is held at both ends.
strap_slot_width = 13;  // mm

// Height of each strap slot. [practice]
//   Passes doubled hook-and-loop without forcing it.
strap_slot_height = 2.4;  // mm

// How far the body tube sinks into the underside of the pod. [practice]
//   Deep enough that the pod cannot rock on the tube, shallow enough that the
//   pod does not stand proud of it any further than it must. The saddle is cut
//   for tube_od, so changing the tube diameter reshapes this surface.
pod_saddle_depth = 4;  // mm

// Slack between the board and the cell inside the cavity. [practice]
//   Keeps the board off the pouch. Foam or tape fills it on assembly.
pod_cavity_gap = 1;  // mm

// Cavity length added at each end for the screw bosses. [practice]
//   The cap screws into two bosses standing inside the cavity, clear of the
//   board at both ends. This is the room they need.
pod_boss_pad = 5.5;  // mm

// How far the base wall continues up inside the cap. [practice]
//   A spigot, so the two halves locate on each other rather than on the two
//   screws. Screws through an unaligned joint bend the cap instead of closing
//   it.
pod_lip_height = 2.5;  // mm

// Number of static port pilot marks. [derived]
//   From the rule on the Mounting page: more than one, evenly spaced, to average
//   out yaw and roll. Four is the count that page recommends. The diameter is
//   deliberately not published here, and the pod prints dimples rather than
//   holes for that reason.
port_count = 4;

// --------------------------------------------------------------------------
// SLED
// The internal carrier, Form A.

// Height of the side rails that locate the sled in the tube. [practice]
//   Enough to keep the sled from rotating in the tube without turning it into a
//   piston that has to be forced in.
sled_rail_height = 3;  // mm

// Height of the end stops that keep the board from sliding out. [practice]
sled_end_stop = 4;  // mm

