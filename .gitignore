# Secrets. The .env at the repo root is never committed; .env.example documents
# the shape of it instead.
.env
.env.local
.env.*.local

# Dependencies
node_modules/
.yarn/cache
.yarn/install-state.gz

# Build output
.next/
.next-dev/
out/
dist/
*.tsbuildinfo

# Hosting
.vercel

# Editors and OS
.idea
*.iml
.DS_Store
.vscode/

# tscircuit keeps its own node_modules, outside the yarn workspace
hardware/node_modules/
hardware/.build/

# The firmware build tree. CMake writes the enforcement check scripts into it at
# configure time, so it is generated in full and none of it is source.
firmware/build/
firmware/build-*/

# tscircuit build cache and its intermediate circuit JSON
hardware/.tscircuit/
hardware/oapogee.circuit.json

# Scratch circuit exports from routing experiments. Six of these were committed
# once, about 5 MB of them, referenced by nothing. The two stamps that ARE read
# are hardware/rendered.json and hardware/pcb-status.json, which are not this.
hardware/*.circuit.json
hardware/probe.json
hardware/.seqdone
