# Copy to .env and fill in. The real .env is never committed.
#
# oApogee is deliberately close to zero-configuration. The site renders content/
# and data/ at build time, so there is no database, no auth, and no runtime API.
# If this file starts growing, that is worth questioning before it is worth
# filling in.

# Canonical origin, used for metadata and Open Graph URLs.
# Local: http://localhost:3000
# Production: https://oapogee.space
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Account-level Vercel token for CLI deploys. Not needed to run the site, and
# not set as a project environment variable in Vercel.
VERCEL_TOKEN=
